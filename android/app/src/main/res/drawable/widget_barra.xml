<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:id="@android:id/background">
        <shape android:shape="rectangle">
            <solid android:color="@color/widget_cartao" />
            <stroke android:width="2dp" android:color="@color/widget_linha" />
            <corners android:radius="8dp" />
        </shape>
    </item>
    <item android:id="@android:id/progress" android:top="2dp" android:bottom="2dp" android:left="2dp" android:right="2dp">
        <clip>
            <shape android:shape="rectangle">
                <solid android:color="@color/widget_agua" />
                <corners android:radius="6dp" />
            </shape>
        </clip>
    </item>
</layer-list>
